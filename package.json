{
  "name": "rideon",
  "packageManager": "pnpm@11.25.0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=backend/.env scripts/dev.mjs",
    "typecheck": "pnpm --recursive typecheck",
    "build": "pnpm typecheck && pnpm --filter @rideon/frontend build",
    "start": "pnpm --filter @rideon/backend start",
    "preview": "pnpm start",
    "test": "pnpm --filter @rideon/backend test"
  }
}
